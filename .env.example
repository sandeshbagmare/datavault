# DataVault Environment Configuration
# Copy this file to .env and configure your preferred provider or endpoint

# -----------------------------------------------------------------------------
# 1. LLM Provider & Endpoint Configuration
# -----------------------------------------------------------------------------
# Supports:
# - Standard: openai, google, anthropic
# - OpenAI-Compatible: openrouter, groq, deepseek, together, mistral, cerebras, fireworks
# - Local / Self-Hosted: ollama, vllm, lmstudio, localai, custom
LLM_PROVIDER=openai

# Model identifier (e.g. gpt-4o, gemini-2.0-flash, claude-3-5-sonnet-20241022, deepseek-chat, llama-3.3-70b-versatile)
LLM_MODEL=gpt-4o

# API Key (Accepts LLM_API_KEY, or provider-specific keys like OPENAI_API_KEY, GOOGLE_API_KEY, etc.)
LLM_API_KEY=sk-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Custom Base URL / API Base (Optional - use for any custom endpoint, proxy, or local server)
# Examples:
#   OpenRouter:  https://openrouter.ai/api/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   Together:    https://api.together.xyz/v1
#   Ollama:      http://localhost:11434/v1
#   vLLM:        http://localhost:8000/v1
#   LM Studio:   http://localhost:1234/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1
# API_BASE=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# 2. MCP Server Connection
# -----------------------------------------------------------------------------
MCP_SERVER_COMMAND=python
MCP_SERVER_SCRIPT=mcp_servers/vehicle_sales/server.py

# -----------------------------------------------------------------------------
# 3. Data & Storage Settings
# -----------------------------------------------------------------------------
DATA_DIR=mcp_servers/vehicle_sales/data
GENERATED_VIZ_DIR=output/viz
GENERATED_REPORTS_DIR=output/reports

# -----------------------------------------------------------------------------
# 4. FastAPI Server & UI
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
